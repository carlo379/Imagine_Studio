{
  "name": "imagine-production-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build_frontend.mjs && npm run build:camera",
    "build:camera": "esbuild ui/camera-renderer.ts --bundle --minify --target=es2022 --format=iife --global-name=ImagineCameraRenderer --outfile=static/camera-renderer.js && esbuild ui/camera-renderer.ts --bundle --target=es2022 --platform=node --format=cjs --outfile=static/camera-renderer.cjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.10",
    "react": "^19.2.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.0"
  }
}
